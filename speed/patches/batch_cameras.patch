+
+"""Tests for SmolVLA's batched camera encoding at inference.
+
+Mirrors ``tests/policies/pi0_pi05/test_pi0_vision_inference.py``: cameras are embedded as one
+batched vision-encoder call at inference and one call each during training.
+"""
+
+import torch
+
+from lerobot.policies.smolvla.configuration_smolvla import SmolVLAConfig
+from tests.utils import require_cuda, skip_if_package_missing
+
+TOKENS_PER_IMAGE = 4
+EMBED_DIM = 8
+
+
+class _RecordingVisionEncoder:
+    """Stands in for ``vlm_with_expert``, recording the batch size of every call."""
+
+    def __init__(self):
+        self.call_batch_sizes: list[int] = []
+
+    def embed_image(self, image: torch.Tensor) -> torch.Tensor:
+        self.call_batch_sizes.append(image.shape[0])
+        # Make the output a recognizable function of the input, so splitting the batched call
+        # back into per-camera chunks in the wrong order would show up.
+        marker = image.flatten(1).mean(dim=1)
+        return marker[:, None, None].expand(image.shape[0], TOKENS_PER_IMAGE, EMBED_DIM).clone()
+
+
+def _harness(training: bool) -> torch.nn.Module:
+    """Exercises ``VLAFlowMatching._embed_images`` without building the VLM."""
+    from lerobot.policies.smolvla.modeling_smolvla import VLAFlowMatching
+
+    class Harness(torch.nn.Module):
+        _embed_images = VLAFlowMatching._embed_images
+
+        def __init__(self):
+            super().__init__()
+            self.vlm_with_expert = _RecordingVisionEncoder()
+
+    return Harness().train(training)
+
+
+def _distinct_images(count: int, batch: int = 1) -> list[torch.Tensor]:
+    return [torch.full((batch, 3, 4, 4), float(i + 1)) for i in range(count)]
+
+
+@skip_if_package_missing("transformers")
+def test_inference_embeds_all_cameras_in_one_call():
+    harness = _harness(training=False)
+
+    harness._embed_images(_distinct_images(3))  # noqa: SLF001
+
+    assert harness.vlm_with_expert.call_batch_sizes == [3]
+
+
+@skip_if_package_missing("transformers")
+def test_training_keeps_one_call_per_camera():
+    # With an unfrozen vision encoder, batching would multiply peak activation memory by the
+    # number of cameras during the backward pass.
+    harness = _harness(training=True)
+
+    harness._embed_images(_distinct_images(3))  # noqa: SLF001
+
+    assert harness.vlm_with_expert.call_batch_sizes == [1, 1, 1]
+
+
+@skip_if_package_missing("transformers")
+def test_batching_returns_the_same_embeddings_in_the_same_order():
+    images = _distinct_images(3, batch=2)
+
+    looped = _harness(training=True)._embed_images(images)  # noqa: SLF001
+    batched = _harness(training=False)._embed_images(images)  # noqa: SLF001
+
+    assert len(batched) == len(looped) == 3
+    for one, many in zip(looped, batched, strict=True):
+        assert one.shape == many.shape == (2, TOKENS_PER_IMAGE, EMBED_DIM)
+        torch.testing.assert_close(one, many)
+
+
+@skip_if_package_missing("transformers")
+def test_a_single_camera_is_not_needlessly_reshaped():
+    harness = _harness(training=False)
+
+    harness._embed_images(_distinct_images(1))  # noqa: SLF001
+
+    assert harness.vlm_with_expert.call_batch_sizes == [1]
+
+
+@skip_if_package_missing("transformers")
+def test_mixed_shapes_fall_back_to_one_call_per_camera():
+    harness = _harness(training=False)
+
+    harness._embed_images([torch.ones(1, 3, 4, 4), torch.ones(1, 3, 8, 8)])  # noqa: SLF001
+
+    assert harness.vlm_with_expert.call_batch_sizes == [1, 1]
+
+
+@skip_if_package_missing("transformers")
+@require_cuda
+def test_batched_and_looped_embeddings_match_on_the_real_vision_encoder():
+    from lerobot.policies.smolvla.modeling_smolvla import VLAFlowMatching
+
+    torch.manual_seed(0)
+    model = VLAFlowMatching(SmolVLAConfig()).to("cuda").eval()
+    images = [torch.rand(1, 3, 512, 512, device="cuda") * 2 - 1 for _ in range(3)]
+
+    with torch.no_grad():
+        batched = model._embed_images(images)  # noqa: SLF001
+        model.train()
+        looped = model._embed_images(images)  # noqa: SLF001
+
+    for one, many in zip(looped, batched, strict=True):
+        # The vision encoder runs in bfloat16, and the two paths use different kernel shapes.
+        torch.testing.assert_close(one, many, rtol=2e-2, atol=2e-2)
